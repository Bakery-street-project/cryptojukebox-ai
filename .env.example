# Optional — all features degrade gracefully without these.
# LLM re-telling of the walked dream (unset = local mechanism engine;
# the dreamSeed and all measured meta stay the machine's own either way):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# JUKEBOX_LLM_MODEL=gpt-4o-mini
# Spotify 30s-preview ingest (unset = Spotify links explain the DRM limit):
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# HTTP port:
PORT=8787

# --- Crypto-fee gate (x402) --------------------------------------------------
# off | mock | x402-testnet   (off = no payment required, current behavior;
# mock = fake facilitator for local/E2E tests; x402-testnet = real protocol,
# test USDC on Base Sepolia, NO real money)
JUKEBOX_PAYMENTS=off
# Your receiving wallet ADDRESS (public). The server is watch/settle-only:
# never store a private key or seed phrase anywhere in this project or .env.
JUKEBOX_PAY_TO=
JUKEBOX_PAY_NETWORK=base-sepolia
JUKEBOX_PAY_PRICE_USDC=0.05
# Required for x402-testnet (https facilitator that verifies + settles for you);
# ignored by mock.
JUKEBOX_X402_FACILITATOR_URL=
